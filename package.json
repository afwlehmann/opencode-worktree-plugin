{
  "name": "opencode-worktree-plugin",
  "version": "0.6.1",
  "description": "Git worktree management plugin for opencode \u2014 create, merge, and remove worktrees with dynamic permissions and TUI status bar",
  "type": "module",
  "license": "MIT",
  "author": "Alexander Lehmann <afwlehmann@googlemail.com>",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./types/tui.d.ts"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/integration.test.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.15",
    "@opencode-ai/sdk": "^1.18.15",
    "effect": "^4.0.0-beta.83"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": "1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@opentui/core": "^0.5.1",
    "@opentui/solid": "^0.5.1",
    "@types/bun": "^1.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vitest": "^0.5.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.11.1",
    "solid-js": "^1.9.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commitlint --edit $1"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.tsx": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,mjs}": [
      "prettier --write"
    ]
  }
}
